# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Service role — APENAS server-side, nunca expor no frontend
# Necessária para audit_logs e operações administrativas
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# ─── Google Calendar ──────────────────────────────────────────────────────────
# Chave de leitura (pública — OK no frontend)
NEXT_PUBLIC_GOOGLE_API_KEY=sua_google_api_key_aqui

# ─── n8n ──────────────────────────────────────────────────────────────────────
# Secret compartilhado para autenticar webhooks vindos do n8n
N8N_WEBHOOK_SECRET=gere_com_openssl_rand_hex_32

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://myclinica.dimitresouza.com

# ─── Staging (para CI/CD) ────────────────────────────────────────────────────
# STAGING_URL=https://staging.myclinica.dimitresouza.com

# ─── WhatsApp (Evolution API do MyClinica) ───────────────────────────────────
# Servidor da Evolution e chave global (AUTHENTICATION_API_KEY dela). Só no servidor.
EVOLUTION_API_URL=https://SEU-SERVICO-EVOLUTION.easypanel.host
EVOLUTION_API_KEY=gere_com_openssl_rand_hex_24
# Endereço público do webhook do app e o token que a Evolution manda no cabeçalho
# x-webhook-token. Deixar VAZIO em desenvolvimento local (não registrar localhost).
WHATSAPP_WEBHOOK_URL=https://SEU_DOMINIO/api/whatsapp/webhook
WHATSAPP_WEBHOOK_TOKEN=gere_com_openssl_rand_hex_32
# Segredo do agendador (cron da VPS) que chama /api/whatsapp/run-confirmations e /api/crm/automate
CRON_SECRET=gere_com_openssl_rand_hex_32

# ─── Integração com o Gestor ─────────────────────────────────────────────────
# Segredo compartilhado com o Gestor (~/sistema_gestao, variável MYCLINICA_API_KEY lá).
# Autentica /api/integracoes/gestor/* via "Authorization: Bearer <chave>". Sem ela a
# integração fica desligada (503). Gere com: openssl rand -hex 32
GESTOR_INTEGRATION_KEY=

# ─── IA via Gestor (escriba) ─────────────────────────────────────────────────
# O MyClinica NÃO tem chave de provedor de IA: chama o Gestor server-to-server. Só no servidor.
# Ver docs/ia-gateway-myclinica.md. Sem as duas, a IA fica desligada (falha fechada).
GESTOR_API_URL=
GESTOR_IA_KEY=

# ─── Automação das clínicas (n8n) ────────────────────────────────────────────
# Segredo compartilhado com o n8n. Autentica /api/automacao/* via "Authorization: Bearer <chave>".
# Sem ela essas rotas ficam desligadas (503). Gere com: openssl rand -hex 32
AUTOMACAO_N8N_KEY=
# Opcional: URL do webhook do n8n que recebe as mensagens da automação (boas-vindas, resposta à confirmação).
# Sem ela, o webhook do WhatsApp não repassa nada ao n8n.
AUTOMACAO_N8N_WEBHOOK_URL=
# Opcional: se definido, vai no cabeçalho x-webhook-token do repasse (o n8n confere).
AUTOMACAO_N8N_WEBHOOK_TOKEN=

# ─── Contrato da clínica (assinatura eletrônica) ─────────────────────────────
# Instância do Evolution (WhatsApp) que envia o código de 6 dígitos. Sem ela o envio responde 503.
MYCLINICA_CONTRACT_WA_INSTANCE=
# Segredo do HMAC do código (16+ caracteres). Opcional: sem ele deriva da chave de serviço do Supabase.
# Gere com: openssl rand -hex 32
CONTRACT_CODE_SECRET=
# Dados da empresa contratada que entram no texto do contrato. Sem eles criar o contrato responde 503.
MYCLINICA_CONTRATADA_RAZAO_SOCIAL=
MYCLINICA_CONTRATADA_CNPJ=
MYCLINICA_CONTRATADA_CIDADE_UF=

# ─── Asaas (cobrança) ────────────────────────────────────────────────────────
# ASAAS_ENV=sandbox aponta a API para https://api-sandbox.asaas.com/v3 (use a chave do sandbox em ASAAS_API_KEY).
# Qualquer outro valor, ou vazio, usa produção (https://api.asaas.com/v3).
ASAAS_ENV=
