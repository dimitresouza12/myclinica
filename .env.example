# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Service role — APENAS server-side, nunca expor no frontend
# Necessária para audit_logs e operações administrativas
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# ─── Google Calendar ──────────────────────────────────────────────────────────
# Chave de leitura (pública — OK no frontend)
NEXT_PUBLIC_GOOGLE_API_KEY=sua_google_api_key_aqui

# ─── n8n ──────────────────────────────────────────────────────────────────────
# Secret compartilhado para autenticar webhooks vindos do n8n
N8N_WEBHOOK_SECRET=gere_com_openssl_rand_hex_32

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://myclinica.dimitresouza.com

# ─── Staging (para CI/CD) ────────────────────────────────────────────────────
# STAGING_URL=https://staging.myclinica.dimitresouza.com
